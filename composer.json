{
    "name": "mj-zana/core",
    "description": "Application, service providers, modules and the boot lifecycle for Zana applications",
    "type": "library",
    "keywords": ["zana", "core", "application", "modules", "service-provider", "lifecycle"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/configuration": "^2.0",
        "mj-zana/container": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Core\\Tests\\": "tests/",
            "Modules\\": "tests/Fixtures/app/modules/"
        },
        "files": ["tests/Fixtures/Providers.php"]
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.0.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.0.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
