{
    "name": "zana/core",
    "description": "Application lifecycle and composition root for Zana applications",
    "type": "library",
    "keywords": ["zana", "core", "application", "lifecycle"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "zana/container": "^1.0",
        "zana/configuration": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Core\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

